{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pol4720/Hybrid-Modeling-KB/schemas/algorithm.schema.json",
  "title": "Frontmatter de fichas tipo 'algorithm'",
  "type": "object",
  "properties": {
    "type": {
      "const": "algorithm"
    },
    "problem": {
      "type": "string"
    },
    "formalisms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FRM|PRC)-"
      },
      "minItems": 1
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^LIB-"
      }
    },
    "refs": {
      "minItems": 1
    }
  },
  "required": [
    "problem",
    "formalisms",
    "refs"
  ]
}
