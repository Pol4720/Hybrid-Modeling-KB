{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pol4720/Hybrid-Modeling-KB/schemas/library.schema.json",
  "title": "Frontmatter de fichas tipo 'library'",
  "type": "object",
  "properties": {
    "type": {
      "const": "library"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "license": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "integration": {
      "enum": [
        "integrate",
        "wrap",
        "reimplement",
        "reference-only",
        "avoid"
      ]
    },
    "license_class": {
      "enum": [
        "permissive",
        "weak-copyleft",
        "strong-copyleft",
        "proprietary",
        "mixed"
      ]
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FRM|PRC)-"
      }
    }
  },
  "required": [
    "url",
    "license",
    "language",
    "integration"
  ]
}
