{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pol4720/Hybrid-Modeling-KB/schemas/platform.schema.json",
  "title": "Frontmatter de fichas tipo 'platform'",
  "type": "object",
  "properties": {
    "type": {
      "const": "platform"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "license": {
      "type": "string"
    },
    "paradigms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FRM-"
      },
      "minItems": 1
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "url",
    "license",
    "paradigms",
    "last_checked",
    "refs"
  ]
}
