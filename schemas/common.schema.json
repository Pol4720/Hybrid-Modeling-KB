{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pol4720/Hybrid-Modeling-KB/schemas/common.schema.json",
  "title": "Campos comunes a toda ficha",
  "type": "object",
  "required": ["id", "type", "title", "status", "updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^(FRM|PRC|CMP|PLT|ALG|LIB|BEN|MOD|DPK|PAP|ADR|DOC|GAP)-[A-Za-z0-9][A-Za-z0-9._\\-]*$"},
    "type": {"enum": ["formalism", "processing", "composition", "platform", "algorithm", "library", "benchmark", "domain-model", "domain-pack", "paper", "adr", "doc", "gap"]},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["draft", "reviewed", "stable", "deprecated"]},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_\\-]+$"}, "uniqueItems": true},
    "related": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": "string"},
    "phase": {"type": "integer", "minimum": 0, "maximum": 5},
    "baseline_support": {"enum": ["none", "partial", "full"], "description": "Soporte en la plataforma actual (Hybrid-Modeling @ de56ed9)."},
    "target_level": {"enum": ["L0", "L1", "L2", "L3"], "description": "Nivel de profundidad objetivo (ver docs/00-vision/depth-levels.md)."}
  }
}
